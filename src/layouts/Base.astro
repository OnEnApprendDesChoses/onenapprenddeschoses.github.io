---
import { ui } from "../lib/blog";

interface Props { lang: "fr" | "en"; title?: string; description?: string }
const { lang, title, description } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.blogName}` : `${t.blogName} — ${t.tagline}`;
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
</head>
<body>
  <style is:global>
    :root {
      color-scheme: light dark;
      --bg: #faf9f7; --fg: #292524; --muted: #78716c; --accent: #ea580c; --card: #ffffff;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #1c1917; --fg: #faf9f7; --muted: #a8a29e; --accent: #fb923c; --card: #292524; }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--bg); color: var(--fg); line-height: 1.7;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .wrap { max-width: 720px; margin: 0 auto; padding: 1.5rem; }
    header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
    header a { color: var(--fg); text-decoration: none; font-weight: 700; }
    nav a { color: var(--muted); text-decoration: none; margin-left: 1rem; font-weight: 500; }
    nav a:hover { color: var(--accent); }
    h1 { font-size: 1.9rem; letter-spacing: -0.02em; }
    h2 { margin-top: 2rem; }
    a { color: var(--accent); }
    .muted { color: var(--muted); font-size: 0.9rem; }
    .post-card {
      display: block; background: var(--card); border: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
      border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; text-decoration: none; color: var(--fg);
    }
    .post-card:hover { border-color: var(--accent); }
    .badge {
      display: inline-block; font-size: 0.75rem; font-weight: 600; color: var(--accent);
      border: 1px solid var(--accent); border-radius: 999px; padding: 0.1rem 0.6rem; margin-left: 0.5rem;
    }
    article img { max-width: 100%; border-radius: 12px; }
    pre { overflow-x: auto; padding: 1rem; border-radius: 8px; background: color-mix(in srgb, var(--fg) 8%, var(--card)); }
    .lang-switch { font-size: 0.85rem; }
  </style>
  <div class="wrap">
    <header>
      <a href={`/${lang === "fr" ? "" : "en"}`}>{t.blogName}</a>
      <nav>
        <a href={lang === "fr" ? "/about" : "/en/about"}>{t.about}</a>
        <a href={lang === "fr" ? "/" : "/en"}>{lang === "fr" ? "EN" : "FR"}</a>
      </nav>
    </header>
    <slot />
    <footer class="muted" style="margin-top:3rem">
      © {new Date().getFullYear()} · {t.blogName}
    </footer>
  </div>
</body>
</html>
