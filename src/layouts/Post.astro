---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import { ui, formatDate, findTranslation } from "../lib/blog";

export interface Props { post: CollectionEntry<"blog"> }

const { post } = Astro.props;
const lang = post.data.lang as "fr" | "en";
const t = ui[lang];
const { Content } = await render(post);
const all = await getCollection("blog");
const translation = findTranslation(post, all);
const slug = (p: CollectionEntry<"blog">) => p.id.replace(/^.*\//, "").replace(/\.md$/, "");
const postUrl = (p: CollectionEntry<"blog">) =>
  p.data.lang === "fr" ? `/blog/${slug(p)}` : `/en/blog/${slug(p)}`;
---

<Base lang={lang} title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="muted">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      {post.data.tags.map((tag) => <span class="badge">#{tag}</span>)}
    </p>
    {translation && (
      <p class="lang-switch">
        🌐 <a href={postUrl(translation)}>
          {t.readIn} {translation.data.lang === "fr" ? "français" : "English"}
        </a>
      </p>
    )}
    <Content />
  </article>
</Base>
